{
  "name": "file-manager",
  "private": true,
  "version": "0.1.20",
  "description": "Cross-platform ranger-inspired file manager with native drag-out",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "predev": "node -e \"try{if(process.platform!=='win32')require('child_process').execSync('pkill -f \\\"'+process.cwd()+'/node_modules/electron/dist/electron\\\"',{stdio:'ignore'})}catch{}\"",
    "dev": "vite",
    "dev:main": "node scripts/dev-main-rebuild.mjs",
    "prestable": "npm run predev",
    "stable": "BREEZE_PROFILE=default vite",
    "build:native": "node -e \"if(process.platform==='darwin'){require('child_process').execSync('make -C native/sharer',{stdio:'inherit'})}else{console.log('build:native: skipped on '+process.platform)}\"",
    "build": "npm run build:native && tsc -b && vite build",
    "build:daemon": "node daemon/build.mjs",
    "start": "npm run dev",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test tests/*.test.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3,better-sqlite3-multiple-ciphers,@homebridge/node-pty-prebuilt-multiarch"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "@copilotkit/core": "^1.62.1",
    "@copilotkit/react-core": "^1.62.1",
    "@copilotkit/runtime": "^1.62.1",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@milkdown/core": "^7.21.1",
    "@milkdown/crepe": "^7.21.1",
    "@milkdown/ctx": "^7.21.1",
    "@milkdown/preset-commonmark": "^7.21.1",
    "@milkdown/preset-gfm": "^7.21.1",
    "@milkdown/theme-nord": "^7.21.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "better-sqlite3-multiple-ciphers": "^12.9.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "com.vivek.breezefile",
    "productName": "TypeBuild",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist",
      "dist-electron",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/@homebridge/node-pty-prebuilt-multiarch/**/*",
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/better-sqlite3-multiple-ciphers/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "extraResources": [
        {
          "from": "native/sharer/sharer",
          "to": "sharer"
        },
        {
          "from": "bin/breeze-tools",
          "to": "automation/bin/breeze-tools"
        },
        {
          "from": "bin/breeze-tools.mjs",
          "to": "automation/bin/breeze-tools.mjs"
        },
        {
          "from": "electron/browser",
          "to": "automation/electron/browser",
          "filter": [
            "**/*.mjs",
            "**/*.json"
          ]
        },
        {
          "from": "node_modules/playwright-core",
          "to": "automation/node_modules/playwright-core"
        }
      ],
      "icon": "build/icon.icns",
      "artifactName": "Breezefile-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "TypeBuild needs access to your Documents folder to browse and manage files.",
        "NSDownloadsFolderUsageDescription": "TypeBuild needs access to your Downloads folder to browse and manage files.",
        "NSDesktopFolderUsageDescription": "TypeBuild needs access to your Desktop folder to browse and manage files.",
        "NSRemovableVolumesUsageDescription": "TypeBuild needs access to removable volumes (USB drives, SD cards) to browse and manage files.",
        "NSNetworkVolumesUsageDescription": "TypeBuild needs access to network volumes to browse and manage files.",
        "NSAppleEventsUsageDescription": "TypeBuild uses Apple Events to open files in other applications and reveal them in Finder.",
        "NSSystemAdministrationUsageDescription": "TypeBuild needs access to system folders to browse and manage files."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Breezefile-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "bin/breeze-tools.cmd",
          "to": "automation/bin/breeze-tools.cmd"
        },
        {
          "from": "bin/breeze-tools.mjs",
          "to": "automation/bin/breeze-tools.mjs"
        },
        {
          "from": "electron/browser",
          "to": "automation/electron/browser",
          "filter": [
            "**/*.mjs",
            "**/*.json"
          ]
        },
        {
          "from": "node_modules/playwright-core",
          "to": "automation/node_modules/playwright-core"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "extraResources": [
        {
          "from": "bin/breeze-tools",
          "to": "automation/bin/breeze-tools"
        },
        {
          "from": "bin/breeze-tools.mjs",
          "to": "automation/bin/breeze-tools.mjs"
        },
        {
          "from": "electron/browser",
          "to": "automation/electron/browser",
          "filter": [
            "**/*.mjs",
            "**/*.json"
          ]
        },
        {
          "from": "node_modules/playwright-core",
          "to": "automation/node_modules/playwright-core"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
